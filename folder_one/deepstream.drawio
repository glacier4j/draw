        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==================== 输入层 ====================\n    A[多路视频输入&lt;br/&gt;RTSP / 文件]\n\n    A --&gt; B1[nvurisrcbin&lt;br/&gt;Source 0]\n    A --&gt; B2[nvurisrcbin&lt;br/&gt;Source 1]\n    A --&gt; B3[nvurisrcbin&lt;br/&gt;Source N]\n\n    %% ==================== 视频预处理 ====================\n    B1 --&gt; C[nvstreammux&lt;br/&gt;多路视频合批]\n    B2 --&gt; C\n    B3 --&gt; C\n\n    C --&gt; D[pre-infer-queue&lt;br/&gt;推理前缓冲]\n\n    %% ==================== AI检测 ====================\n    D --&gt; E[nvinfer&lt;br/&gt;YOLO目标检测]\n\n    E --&gt; F[pre-tracker-queue&lt;br/&gt;跟踪前缓冲]\n\n    %% ==================== 多目标跟踪 ====================\n    F --&gt; G[nvtracker&lt;br/&gt;多目标跟踪&lt;br/&gt;生成 Track ID]\n\n    %% ==================== 业务处理 ====================\n    G --&gt; H[Probe&lt;br/&gt;MultiStreamSpeedEstimator]\n\n    H --&gt; I[测速业务逻辑&lt;br/&gt;目标轨迹 / 位移 / 时间]\n    I --&gt; J[速度计算]\n    J --&gt; K[kafka-python&lt;br/&gt;Kafka消息发送]\n    K --&gt; L[Kafka]\n\n    %% ==================== 视频输出分支 ====================\n    G --&gt; M[tee&lt;br/&gt;视频流分发]\n\n    M --&gt; N[pre-tiler-queue&lt;br/&gt;拼接前缓冲]\n\n    N --&gt; O[nvmultistreamtiler&lt;br/&gt;多路画面拼接]\n\n    O --&gt; P[nvvideoconvert&lt;br/&gt;OSD格式转换]\n\n    P --&gt; Q[capsfilter&lt;br/&gt;RGBA / NVMM]\n\n    Q --&gt; R[nvdsosd&lt;br/&gt;目标框 / Track ID / 速度信息]\n\n    R --&gt; S[pre-encoder-queue&lt;br/&gt;编码前缓冲]\n\n    S --&gt; T[nvvideoconvert&lt;br/&gt;编码格式转换]\n\n    T --&gt; U[capsfilter&lt;br/&gt;I420 / NVMM]\n\n    U --&gt; V[nvv4l2h264enc&lt;br/&gt;H.264硬件编码]\n\n    V --&gt; W[h264parse&lt;br/&gt;H.264码流解析]\n\n    W --&gt; X[rtspclientsink&lt;br/&gt;RTSP推流]\n\n    X --&gt; Y[RTSP输出]\n\n    %% ==================== 样式 ====================\n    classDef input fill:#E3F2FD,stroke:#1976D2,stroke-width:2px;\n    classDef inference fill:#FFF3E0,stroke:#F57C00,stroke-width:2px;\n    classDef tracking fill:#E8F5E9,stroke:#388E3C,stroke-width:2px;\n    classDef business fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px;\n    classDef output fill:#FCE4EC,stroke:#C2185B,stroke-width:2px;\n\n    class A,B1,B2,B3,C,D input;\n    class E,F inference;\n    class G tracking;\n    class H,I,J,K,L business;\n    class M,N,O,P,Q,R,S,T,U,V,W,X,Y output;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qgDNUj0yPTH6b11UEZxX-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
